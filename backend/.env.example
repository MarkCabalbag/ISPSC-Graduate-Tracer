# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL >= 15) ---
# Runtime connection string used by the API (lib/prisma.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Direct (non-pooled) connection used by the Prisma CLI for migrations (prisma.config.ts).
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# --- Admin sign-in ---
ADMIN_USERNAME="admin"
# bcrypt hash of the admin password (never the password itself). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# In a .env file wrap the hash in single quotes so `$` is not expanded.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-your-bcrypt-hash'
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# --- Web ---
# Exact frontend origin(s), comma separated, with https:// and no trailing slash.
CLIENT_URL="http://localhost:5173"
PORT=8080
NODE_ENV=development
# Set to 1 when running behind a proxy/host (Render, Railway, Nginx).
TRUST_PROXY=

# --- Confirmation email (Gmail app password, not your account password) ---
EMAIL_FROM="no-reply@example.com"
EMAIL_PASS="replace-with-gmail-app-password"
