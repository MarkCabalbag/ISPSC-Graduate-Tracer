# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The API validates these at startup (lib/env.ts) and refuses to start with a missing
# or unsafe value, naming the variable (never its value).

# --- Database (PostgreSQL >= 15) ---
# Runtime connection string used by the API (lib/prisma.ts). In production use a
# database user with data access only (SELECT/INSERT/UPDATE/DELETE), not the owner.
# A database reached over the internet MUST end with ?sslmode=require in production.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Direct (non-pooled) connection used by the Prisma CLI for migrations (prisma.config.ts).
# In production this is the schema owner; the running API never uses it.
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# --- First admin (seed only) ---
# Admins live in the Admin table. These two create the FIRST one when you run
# `npm run seed` (after applying the migration). The running server never reads
# them; add or reset more admins with `npm run admin:create` / `admin:reset`.
ADMIN_USERNAME="admin"
# bcrypt hash of the admin password (never the password itself). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# In a .env file wrap the hash in single quotes so `$` is not expanded.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-your-bcrypt-hash'

# --- Session ---
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# --- Web ---
# Exact frontend origin(s), comma separated, with https:// and no trailing slash.
# Production requires https.
CLIENT_URL="http://localhost:5173"
PORT=8080
# development | test | production. Set `production` on the live server: it makes the
# session cookie HTTPS-only and turns on the production checks above.
NODE_ENV=development
# How many proxies sit in front of the API. REQUIRED in production.
#   2 = Render behind the Vercel /api rewrite (Vercel, then Render's load balancer)
#   1 = Render on its own
#   empty = local development
# Wrong values break the rate limits: too low and every visitor shares one limit,
# too high and a caller can forge their IP address.
TRUST_PROXY=
# fatal | error | warn | info | debug | trace. Default: info in production, debug locally.
LOG_LEVEL=

# --- Confirmation email (Gmail app password, not your account password) ---
# Optional: without these the survey still saves and no thank-you email is sent.
EMAIL_FROM="no-reply@example.com"
EMAIL_PASS="replace-with-gmail-app-password"
