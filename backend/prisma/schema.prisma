// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Responses {
  id Int @id @default(autoincrement())
  /// Lower-cased and trimmed on write. Unique so two submissions at the same moment cannot both be stored.
  email String? @unique
  fullName String?
  yearOfGraduation Int?
  yearOfSurvey Int?
  department String?
  program String?
  major String?
  isEmployed String?
  isJobAligned String?
  isSelfEmployed String?
  isFurtherStudies String?
  typeOfOrganization String?
  currentJobLocated String?

  @@index([yearOfGraduation, program])
  @@index([department])
}

model Total {
  id Int @id @default(autoincrement())
  yearOfGraduation Int?
  program String?
  department String?
  totalGraduates Int? @default(0)

  @@unique([yearOfGraduation, program], name: "year_program")
}

model Department {
  id Int @id @default(autoincrement())
  department String
  listOfProgram Program[]
}

model Program{
  id Int @id @default(autoincrement())
  program String
  relatedToDepartment Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId Int
  listOfMajor Major[]

  @@index([departmentId])
}

model Major{
  id Int @id @default(autoincrement())
  major String
  relatedToProgram Program @relation(fields: [programId], references: [id],  onDelete: Cascade)
  programId Int

  @@index([programId])
}

/// An MIS office account that can sign in to the admin. Seeded from the
/// ADMIN_USERNAME / ADMIN_PASSWORD_HASH environment variables (prisma/seed.ts),
/// and managed afterwards with the admin CLI (scripts/admin.ts).
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  /// Raised to end every session of this admin at once (password reset, sign-out-all).
  sessionVersion Int     @default(0)
}

